---
const navItems = [
  { href: '/notes/', label: 'Field Notes' },
  { href: '/projects/', label: 'Projects' },
  { href: '/career/', label: 'Career' },
  { href: '/archive/', label: 'Archive' }
];
---

<header class="site-header">
  <div class="shell nav">
    <a class="brand" href="/" aria-label="이상혁 블로그 홈">
      <span class="brand-mark">LSH</span>
      <span>
        <span class="brand-name">이상혁의 개발 기록</span>
        <span class="brand-sub">AI Agent · Application Architecture · Backend 운영</span>
      </span>
    </a>
    <nav class="nav-links" aria-label="주요 섹션">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>
