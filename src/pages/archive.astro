---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { approvedWriting } from '../lib/content';

const description = '외부 발행 글과 GitHub 블로그로 옮겨올 글감 archive입니다.';
---

<BaseLayout title="Archive | 이상혁의 개발 기록" description={description}>
  <SiteHeader />
  <main>
    <section class="page-hero shell">
      <p class="page-eyebrow">Writing Archive</p>
      <h1>외부 발행 글과 옮겨올 주제</h1>
      <p class="page-lead">
        기존 글은 archive로 두고, 새 글은 GitHub repository와 연결되는 기록으로 확장합니다.
      </p>
    </section>

    <section class="shell page-section writing-list">
      {
        approvedWriting.map((item) => (
          <article class="writing-row">
            {item.url ? <a href={item.url}>{item.title}</a> : <span class="writing-title">{item.title}</span>}
            <span>{item.kind} · {item.tags.join(' · ')}</span>
          </article>
        ))
      }
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
