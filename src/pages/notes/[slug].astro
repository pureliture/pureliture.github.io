---
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { approvedNotes, getEvidenceTargets } from '../../lib/content';

export function getStaticPaths() {
  return approvedNotes.map((note) => ({
    params: { slug: note.slug },
    props: { note }
  }));
}

const { note } = Astro.props;
const evidenceTargets = getEvidenceTargets(note.linkedEvidence);
const description = note.summary;
---

<BaseLayout title={`${note.title} | 이상혁의 개발 기록`} description={description}>
  <SiteHeader />
  <main>
    <article class="shell article-page">
      <header class="article-head">
        <p class="page-eyebrow">{note.kind} / {note.status}</p>
        <h1>{note.title}</h1>
        <p class="page-lead">{note.summary}</p>
        <div class="post-meta">
          {note.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </header>

      <div class="article-body">
        <section class="article-section">
          <h2>기록할 문제</h2>
          <p>
            이 글은 구현 결과를 과장하기보다, 설계 중 반복해서 마주친 판단 기준을 남기는 용도입니다.
            현재 공개 가능한 repository와 연결되는 범위 안에서 문제 정의, 선택지, 운영 관점을 정리합니다.
          </p>
        </section>

        <section class="article-section">
          <h2>연결된 근거</h2>
          <div class="link-list">
            {
              evidenceTargets.map((target) => (
                <a class="button-link" href={target.href}>{target.label}</a>
              ))
            }
          </div>
        </section>

        <section class="article-section">
          <h2>작성 방향</h2>
          <ul class="detail-list">
            <li>문제가 생긴 맥락을 먼저 적고, 구현 세부사항은 필요한 만큼만 둡니다.</li>
            <li>실패 복구, 검증, 운영 가능성처럼 나중에 다시 확인할 기준을 남깁니다.</li>
            <li>비공개 세부사항은 공개 범위에서 제외합니다.</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>
