---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { approvedCareerCaseStudies, approvedCareerTimeline, publishGate } from '../lib/content';

const description = 'AI Agent 개발, Application Architecture, Backend 운영으로 이어지는 경력 맥락입니다.';
---

<BaseLayout title="Career | 이상혁의 개발 기록" description={description}>
  <SiteHeader />
  <main>
    <section class="page-hero shell">
      <p class="page-eyebrow">Career Context</p>
      <h1>Notion 경력서에서 가져온 러프한 Career</h1>
      <p class="page-lead">
        이력서 전체가 아니라 회사명, 기간, 역할 흐름만 공개 가능한 수준으로 정리합니다.
        세부 프로젝트와 proof는 별도 비공개 영역에서 관리합니다.
      </p>
      <div class="status-strip">
        <span>Status</span>
        <strong>{publishGate.status}</strong>
        <span>Review</span>
        <strong>{publishGate.requiredApprovals.length} pending</strong>
      </div>
    </section>

    <section class="wide-section career-band">
      <div class="shell career-layout">
        <section class="career-intro">
          <h2>Timeline</h2>
          <p>현재 관심사는 AI Agent 개발이며, 이전 경력은 운영 가능한 구조를 판단하는 배경으로 정리합니다.</p>
        </section>
        <section class="timeline">
          {
            approvedCareerTimeline.map((item) => (
              <article class="timeline-row">
                <span class="time">{item.period}</span>
                <div>
                  <h3>{item.role}</h3>
                  <span class="org-line">{item.organization}</span>
                  <p>{item.summary}</p>
                </div>
              </article>
            ))
          }
        </section>
      </div>
    </section>

    <section class="wide-section">
      <div class="shell">
        <div class="section-title">
          <h2>Career Snapshot</h2>
          <span>세부 성과가 아닌 역할 흐름 중심</span>
        </div>
        <div class="case-grid">
          {
            approvedCareerCaseStudies.map((study) => (
              <article class="case-card">
                <span class="post-kind">{study.organization} / {study.period}</span>
                <h3>{study.title}</h3>
                <p>{study.summary}</p>
                <div class="post-meta">
                  {study.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
